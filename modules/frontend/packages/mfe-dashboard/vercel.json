{
  "buildCommand": "npm run build && npm run build:module --ignore-scripts",
  "functions": {
    "api/fragments/[...path].ts": {
      "includeFiles": "dist/**"
    },
    "api/fragments/assets/[file].ts": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
